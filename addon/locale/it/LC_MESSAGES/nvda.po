msgstr "Volto chiaramente visibile"

#: addon/globalPlugins/AIContentDescriber/face_view.py:104
msgid "and"
msgstr "e"

#: addon/globalPlugins/AIContentDescriber/face_view.py:104
msgid "the center"
msgstr "rispetto al centro"

#. translators: the message spoken when footage could not be captured from the
#. camera during facial detection
#: addon/globalPlugins/AIContentDescriber/face_view.py:110
msgid ""
"Failed to interface with the camera. Please ensure it is not in use by "
"another application, then try again."
msgstr ""
"Impossibile interfacciarsi con la fotocamera. Assicurati che non sia in uso "
"da un'altra applicazione, quindi riprova."

#. translators: message spoken when the face detection failed because we are
#. on
#. the desktop - a rarely encountered windows bug
#: addon/globalPlugins/AIContentDescriber/face_view.py:124
msgid ""
"The footage from the camera is too blurry. Try switching your focus away "
"from the desktop, then try this command again."
msgstr ""
"Il filmato dalla fotocamera è troppo sfocato. Prova a spostare il focus dal "
"desktop, quindi riprova questo comando."

#. translators: message spoken when the face detection fails because the
#. camera
#. encountered a blurry image
#: addon/globalPlugins/AIContentDescriber/face_view.py:127
#, python-brace-format
msgid ""
"The footage from the camera is too blurry. Please ensure that it is not "
"covered up and that your surroundings have proper lighting. {}"
msgstr ""
"Il filmato dalla fotocamera è troppo sfocato. Assicurati che non sia coperta"
" e che l'ambiente sia ben illuminato. {}"

#. translators: the message spoken when there was no face found in the frame
#: addon/globalPlugins/AIContentDescriber/face_view.py:132
msgid ""
"No face detected. Please ensure your face is in the frame and that your "
"camera is not covered up."
msgstr ""
"Nessun volto rilevato. Assicurati che il tuo volto sia nell'inquadratura e "
"che la tua fotocamera non sia coperta."

#. translators: the message spoken when more than one face was detected
#: addon/globalPlugins/AIContentDescriber/face_view.py:135
#, python-brace-format
msgid ""
"{} faces detected near the frame. Please try for another angle with fewer "
"background objects."
msgstr ""
"{} volti rilevati vicino all'inquadratura. Prova un'altra angolazione con "
"meno oggetti sullo sfondo."

#. translators: the message that gets spoken when facial detection cannot find
#. any cameras
#: addon/globalPlugins/AIContentDescriber/face_view.py:153
#: addon/globalPlugins/AIContentDescriber/face_view.py:174
msgid "No camera found on your system. Please connect one and try again."
msgstr ""
"Nessuna fotocamera trovata sul tuo sistema. Collegarne una e riprovare."

#. translators: message spoken when the camera that was being used before has
#. disconnected
#: addon/globalPlugins/AIContentDescriber/face_view.py:164
#, python-brace-format
msgid "{} is no longer available. Switching to the other on the system."
msgstr "{} non è più disponibile. Passaggio all'altra fotocamera del sistema."

#. translators: message spoken when the camera becomes unavailable between the
#. user selecting it and triggering it again
#: addon/globalPlugins/AIContentDescriber/face_view.py:185
msgid "Camera unavailable. Please try selecting another"
msgstr "Fotocamera non disponibile. Prova a selezionarne un'altra"

#: addon/globalPlugins/AIContentDescriber/face_view.py:188
msgid ""
"Starting the face detection interface. This may take a few seconds. Please "
"wait."
msgstr ""
"Avvio dell'interfaccia di rilevamento del volto. Potrebbero volerci alcuni "
"secondi. Attendere prego."

#. translators: message spoken when we could not interface with the chosen
#. camera
#: addon/globalPlugins/AIContentDescriber/face_view.py:192
msgid "Failed to interface with the chosen camera"
msgstr "Impossibile interfacciarsi con la fotocamera scelta"

