#. Translators: The message displayed if during installation, there is an
#. incompatible version already installed
#: addon/installTasks.py:21
msgid ""
"There appears to be an older version of this add-on installed that is "
"incompatible with future versions because the name has changed. It will be "
"removed the next time NVDA is restarted."
msgstr ""
"Parece que hay una versión anterior de este complemento instalada que no es "
"compatible con versiones futuras porque el nombre ha cambiado. Se eliminará "
"la próxima vez que se reinicie NVDA."

#. Translators: The title of the message dialog when the user is installing
#. the
#. add-on
#. Translators: The label for the category in NVDA settings
#. Translators: title of the computer control consent dialog
#. Translators: Summary for this add-on
#. Add-on summary, usually the user visible name of the addon.
#. to be shown on installation and add-on information found in Add-ons
#. Manager.
#: addon/globalPlugins/AIContentDescriber/__init__.py:98
#: addon/globalPlugins/AIContentDescriber/__init__.py:288
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:174
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:106
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:116
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:126
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:136
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:147
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:157
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:167
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:241
#: addon/installTasks.py:23 buildVars.py:23
msgid "AI Content Describer"
msgstr "Descriptor de Contenido con IA"

#. translators: the button in the settings dialog to open the model manager
#: addon/globalPlugins/AIContentDescriber/__init__.py:103
msgid "Manage &models"
msgstr "Administrar &modelos"

#. translators: the label for the dropdown that lists the currently available
#. models
#: addon/globalPlugins/AIContentDescriber/__init__.py:105
msgid ""
"Model (configure more in the manage models dialog, defaults to last used):"
msgstr ""
"Modelo (configure más en el diálogo de administración de modelos, usa el "
"último modelo utilizado por defecto):"

#. Translators: The label for the option to open results in browsable dialogs
#: addon/globalPlugins/AIContentDescriber/__init__.py:107
msgid ""
"Open each result in a browsable dialog; Markdown will be rendered if "
"possible"
msgstr ""
"Abrir cada resultado en un diálogo navegable; el Markdown se mostrará si es "
"posible"

#. Translators: The label for the checkbox to cache images and their
#. descriptions in the settings dialog
#: addon/globalPlugins/AIContentDescriber/__init__.py:109
msgid "Remember/cache descriptions of each item to save API quota"
msgstr ""
"Recordar/almacenar en caché las descripciones de cada elemento para ahorrar "
"cuota de API"

#. Translators: The label for the checkbox that controls whether to optimize
#. image uploads for size in the settings dialog
#: addon/globalPlugins/AIContentDescriber/__init__.py:111
msgid ""
"Optimize images for size, may speed up detection in some situations "
"(experimental)"
msgstr ""
"Optimizar imágenes por tamaño, puede acelerar la detección en algunas "
"situaciones (experimental)"

#. translators: current focus
#: addon/globalPlugins/AIContentDescriber/__init__.py:158
msgid "Current focus"
msgstr "Foco actual"

#. translators: navigator object
#. Translators: item in the copy image to clipboard submenu that captures the
#. navigator object
#: addon/globalPlugins/AIContentDescriber/__init__.py:160
#: addon/globalPlugins/AIContentDescriber/__init__.py:171
msgid "Navigator object"
msgstr "Objeto del navegador"

#. translators: screenshot of entire window menu item
#. Translators: item in the copy image to clipboard submenu that captures the
#. entire screen
#: addon/globalPlugins/AIContentDescriber/__init__.py:162
#: addon/globalPlugins/AIContentDescriber/__init__.py:173
msgid "Entire screen"
msgstr "Pantalla completa"

#. translators: menu item to reconstruct the screen as accessible HTML
#: addon/globalPlugins/AIContentDescriber/__init__.py:164
msgid "Show UI"
msgstr "Mostrar interfaz"

#. translators: picture from the local camera menu item
#: addon/globalPlugins/AIContentDescriber/__init__.py:166
msgid "Take a picture"
msgstr "Tomar una foto"

#. Translators: item in the copy image to clipboard submenu that captures the
#. focus object
#: addon/globalPlugins/AIContentDescriber/__init__.py:169
msgid "Focus object"
msgstr "Objeto con el foco"

#. Translators: the label for the submenu that copies a captured image to the
#. clipboard without describing it
#: addon/globalPlugins/AIContentDescriber/__init__.py:175
msgid "Copy image to clipboard"
msgstr "Copiar imagen al portapapeles"

#: addon/globalPlugins/AIContentDescriber/__init__.py:178
msgid "Detect face position"
msgstr "Detectar posición facial"

#. self.detect_face_realtime_item = self.face_detection_menu.Append(wx.ID_ANY,
#. _("Real-time face guidance"))
#: addon/globalPlugins/AIContentDescriber/__init__.py:180
msgid "Select camera"
msgstr "Seleccionar cámara"

#: addon/globalPlugins/AIContentDescriber/__init__.py:181
msgid "Release the camera to make it usable by other applications"
msgstr "Liberar la cámara para que pueda ser usada por otras aplicaciones"

#. translators: the label for the submenu that contains the options for face
#. detection. Also informs the user that this feature does not require API
#. access.
#: addon/globalPlugins/AIContentDescriber/__init__.py:183
msgid "Face Detection (no API required)"
msgstr "Detección facial (no se requiere API)"

#. translators: the name of the submenu used to select a model.
#: addon/globalPlugins/AIContentDescriber/__init__.py:194
msgid "Model"
msgstr "Modelo"

#. translators: the label for the item to follow-up on the last description
#: addon/globalPlugins/AIContentDescriber/__init__.py:197
msgid "Follow-up on previous description"
msgstr "Seguimiento de la descripción anterior"

#. Translators: area menu item to start an AI computer control session
#: addon/globalPlugins/AIContentDescriber/__init__.py:203
msgid "Control computer..."
msgstr "Controlar el equipo..."

#. Translators: area menu item shown when the selected model does not support
#. computer control
#: addon/globalPlugins/AIContentDescriber/__init__.py:206
msgid "Control computer (not supported by selected model)"
msgstr "Controlar el equipo (no compatible con el modelo seleccionado)"

#. Translators: title of the dialog shown when the configuration file could
#. not
#. be read
#: addon/globalPlugins/AIContentDescriber/__init__.py:251
msgid "AI Content Describer configuration error"
msgstr "Error de configuración del Descriptor de Contenido con IA"

#: addon/globalPlugins/AIContentDescriber/__init__.py:255
#, python-brace-format
msgid ""
"The AI Content Describer configuration file could not be read: {error}\n"
"\n"
"Your settings were backed up to {backup} and the add-on is now using default settings.\n"
"\n"
"To restore your settings, choose Open configuration, correct the problem and save. Then replace {config} with the corrected file and restart NVDA."
msgstr ""
"No se pudo leer el archivo de configuración del Descriptor de Contenido con IA: {error}\n"
"\n"
"Se hizo una copia de seguridad de su configuración en {backup} y el complemento ahora usa la configuración predeterminada.\n"
"\n"
"Para restaurar su configuración, elija Abrir configuración, corrija el problema y guarde. Luego reemplace {config} con el archivo corregido y reinicie NVDA."

#. Translators: button that opens the backed up configuration file in a text
#. editor
#: addon/globalPlugins/AIContentDescriber/__init__.py:265
msgid "&Open configuration"
msgstr "&Abrir configuración"

#. Translators: button that closes the configuration error dialog
#: addon/globalPlugins/AIContentDescriber/__init__.py:267
msgid "&Close"
msgstr "&Cerrar"

#. Translators: message spoken when there is an attempt to recognize an
#. object,
#. but the screen curtain is running
#. Translators: message spoken when the screen curtain is active and the user
#. attempts to describe the UI
#: addon/globalPlugins/AIContentDescriber/__init__.py:329
#: addon/globalPlugins/AIContentDescriber/__init__.py:376
#: addon/globalPlugins/AIContentDescriber/ui_viewer.py:103
msgid ""
"Please disable windows screen curtain before using AI content describer."
msgstr ""
"Por favor, desactive la cortina de pantalla de Windows antes de usar el "
"descriptor de contenido con IA."

#: addon/globalPlugins/AIContentDescriber/__init__.py:343
msgid "Content is not visible"
msgstr "El contenido no es visible"

#. Translators: Message spoken when the attempt to take a picture of an object
#. fails
#: addon/globalPlugins/AIContentDescriber/__init__.py:354
msgid "Could not snap an image of the requested object"
msgstr "No se pudo capturar una imagen del objeto solicitado"

#. py-3.11: On some machines, it is rare, but cv2 might not work as expected
#. due to a variety of reasons none of which I can reproduce.
#. # In the meantime, establish a catchall exception and report it to the user
#. so they can file an issue
#. Translators: The message spoken when there was an error with the face
#. detection interface.
#: addon/globalPlugins/AIContentDescriber/__init__.py:365
#: addon/globalPlugins/AIContentDescriber/__init__.py:428
#, python-brace-format
msgid ""
"Error initializing the face detection interface. Please consult the NVDA log"
" for more information. {error}"
msgstr ""
"Error al inicializar la interfaz de detección facial. Consulte el registro "
"de NVDA para obtener más información. {error}"

#. Translators: Message spoken when the face detection interface is loading
#: addon/globalPlugins/AIContentDescriber/__init__.py:369
#: addon/globalPlugins/AIContentDescriber/__init__.py:432
msgid ""
"Face detection interface is loading. Please try this command again after a "
"couple seconds."
msgstr ""
"La interfaz de detección facial se está cargando. Intente este comando de "
"nuevo en unos segundos."

#. translators: message spoken when grabbing the content of the current window
#. is not possible
#. Translators: message spoken when capturing the screen fails
#: addon/globalPlugins/AIContentDescriber/__init__.py:381
#: addon/globalPlugins/AIContentDescriber/ui_viewer.py:112
msgid "Could not get window content"
msgstr "No se pudo obtener el contenido de la ventana"

#. Translators: message spoken when a captured image could not be placed on
#. the
#. clipboard
#: addon/globalPlugins/AIContentDescriber/__init__.py:406
msgid "Could not copy the image to the clipboard."
msgstr "No se pudo copiar la imagen al portapapeles."

#. Translators: message spoken when a captured image was copied to the
#. clipboard
#: addon/globalPlugins/AIContentDescriber/__init__.py:410
msgid "Image copied to clipboard."
msgstr "Imagen copiada al portapapeles."

#. translators: message spoken when the picture could not be taken due to an
#. unknown error
#: addon/globalPlugins/AIContentDescriber/__init__.py:439
#: addon/globalPlugins/AIContentDescriber/__init__.py:449
msgid ""
"The picture could not be taken. Please ensure that your camera is not in use"
" by another application and try again."
msgstr ""
"No se pudo tomar la foto. Asegúrese de que su cámara no esté siendo usada "
"por otra aplicación e inténtelo de nuevo."

#. Translators: the message spoken when the picture is taken but the file
#. could
#. not be written.
#: addon/globalPlugins/AIContentDescriber/__init__.py:444
msgid "The picture could not be saved."
msgstr "La foto no se pudo guardar."

#: addon/globalPlugins/AIContentDescriber/__init__.py:454
#: addon/globalPlugins/AIContentDescriber/__init__.py:480
#: addon/globalPlugins/AIContentDescriber/__init__.py:621
msgid "No AI service configured."
msgstr "No hay ningún servicio de IA configurado."

#. Translators: Message spoken when the item copied to the clipboard is not an
#. image
#: addon/globalPlugins/AIContentDescriber/__init__.py:460
#: addon/globalPlugins/AIContentDescriber/__init__.py:471
msgid "The item on the clipboard is not an image."
msgstr "El elemento en el portapapeles no es una imagen."

#. Translators: Message spoken when the image on the clipboard is not a format
#. supported by the current description service
#: addon/globalPlugins/AIContentDescriber/__init__.py:465
#, python-brace-format
msgid ""
"Unsupported image format. Please copy another file to the clipboard that is "
"{formats}"
msgstr ""
"Formato de imagen no compatible. Por favor copie al portapapeles otro "
"archivo que sea {formats}"

#. Translators: Message spoken when the user attempts to describe something
#. but
#. they haven't yet provided an API key or base URL
#. Translators: message spoken when no service is available for UI description
#: addon/globalPlugins/AIContentDescriber/__init__.py:484
#: addon/globalPlugins/AIContentDescriber/ui_viewer.py:107
msgid ""
"To describe content, you must provide an API key or base URL in the AI image"
" describer category of the NVDA settings dialog. Please consult add-on help "
"for more information"
msgstr ""
"Para describir el contenido, debe proporcionar una clave de API o URL base "
"en la categoría de descriptor de imágenes con IA del diálogo de "
"configuración de NVDA. Consulte la ayuda del complemento para obtener más "
"información"

#. Translators: Message spoken when a user attempts to describe something, but
#. they haven't provided a prompt
#: addon/globalPlugins/AIContentDescriber/__init__.py:488
msgid ""
"To describe content, you must define a prompt by navigating to the AI image "
"describer category of the NVDA settings dialog. Please consult add-on help "
"for more information"
msgstr ""
"Para describir el contenido, debe definir un indicador navegando a la "
"categoría de descriptor de imágenes con IA del diálogo de configuración de "
"NVDA. Consulte la ayuda del complemento para obtener más información"

#. Translators: Message spoken after the beep - when we have started fetching
#. the description
#: addon/globalPlugins/AIContentDescriber/__init__.py:497
#, python-brace-format
msgid "Retrieving description using {name}..."
msgstr "Obteniendo descripción usando {name}..."

#. translators: message spoken when an error occurs while describing an image
#: addon/globalPlugins/AIContentDescriber/__init__.py:503
#, python-brace-format
msgid "Error describing image: {error}"
msgstr "Error al describir la imagen: {error}"

#. Translators: Title of the browseable message
#: addon/globalPlugins/AIContentDescriber/__init__.py:514
msgid "Image description"
msgstr "Descripción de imagen"

#. translators: message spoken after the camera has been released successfully
#: addon/globalPlugins/AIContentDescriber/__init__.py:566
msgid "Success"
msgstr "Éxito"

#. translators: The message spoken when the user attempts to show the
#. conversation dialog, but no service is available.
#: addon/globalPlugins/AIContentDescriber/__init__.py:579
msgid "No AI service or conversation available."
msgstr "No hay servicio de IA ni conversación disponible."

#: addon/globalPlugins/AIContentDescriber/__init__.py:585
msgid ""
"Open the AI conversation dialog for follow-up questions and multimodal chat."
msgstr ""
"Abrir el diálogo de conversación con IA para preguntas de seguimiento y chat"
" multimodal."

#: addon/globalPlugins/AIContentDescriber/__init__.py:589
msgid ""
"Describe the image (or file path to an image) on the clipboard using AI."
msgstr ""
"Describir la imagen (o ruta de archivo de una imagen) en el portapapeles "
"usando IA."

#: addon/globalPlugins/AIContentDescriber/__init__.py:593
msgid "Describe the contents of the current navigator object using AI."
msgstr "Describir el contenido del objeto del navegador actual usando IA."

#: addon/globalPlugins/AIContentDescriber/__init__.py:597
msgid "Describe the contents of the currently focused item using AI."
msgstr "Describir el contenido del elemento enfocado actualmente usando IA."

#: addon/globalPlugins/AIContentDescriber/__init__.py:601
msgid "Take a screenshot, then describe it using AI."
msgstr "Tomar una captura de pantalla y luego describirla usando IA."

#: addon/globalPlugins/AIContentDescriber/__init__.py:605
msgid ""
"Takes a screenshot of the current focus object and copies it to the "
"clipboard."
msgstr ""
"Toma una captura de pantalla del objeto con el foco actual y la copia al "
"portapapeles."

#: addon/globalPlugins/AIContentDescriber/__init__.py:609
msgid ""
"Takes a screenshot of the current navigator object and copies it to the "
"clipboard."
msgstr ""
"Toma una captura de pantalla del objeto del navegador actual y la copia al "
"portapapeles."

#: addon/globalPlugins/AIContentDescriber/__init__.py:613
msgid ""
"Takes a screenshot of the entire screen and copies it to the clipboard."
msgstr "Toma una captura de toda la pantalla y la copia al portapapeles."

#: addon/globalPlugins/AIContentDescriber/__init__.py:617
msgid ""
"Pop up a menu asking whether to describe the current focus, navigator "
"object, or entire screen with AI."
msgstr ""
"Mostrar un menú preguntando si describir el foco actual, el objeto del "
"navegador o la pantalla completa con IA."

#: addon/globalPlugins/AIContentDescriber/__init__.py:624
msgid "Computer use is not supported by the selected model."
msgstr "El modelo seleccionado no admite el uso del equipo."

#: addon/globalPlugins/AIContentDescriber/__init__.py:627
msgid "Computer control cannot be used while the screen curtain is active."
msgstr ""
"No se puede usar el control del equipo mientras la cortina de pantalla está "
"activa."

#. Translators: spoken when the pause gesture is pressed but no session is
#. running
#: addon/globalPlugins/AIContentDescriber/__init__.py:641
#: addon/globalPlugins/AIContentDescriber/__init__.py:657
msgid "No active computer control session."
msgstr "No hay ninguna sesión de control del equipo activa."

#. Translators: spoken when a computer control session is resumed
#: addon/globalPlugins/AIContentDescriber/__init__.py:646
msgid "Computer control resumed."
msgstr "Control del equipo reanudado."

#. Translators: spoken when a computer control session is paused
#: addon/globalPlugins/AIContentDescriber/__init__.py:650
msgid "Computer control paused."
msgstr "Control del equipo en pausa."

#: addon/globalPlugins/AIContentDescriber/__init__.py:652
msgid "Pause or resume the active computer control session"
msgstr "Pausa o reanuda la sesión de control del equipo activa"

#. Translators: spoken when the user cancels a computer control session
#: addon/globalPlugins/AIContentDescriber/__init__.py:661
msgid "Computer control session cancelled."
msgstr "Sesión de control del equipo cancelada."

#: addon/globalPlugins/AIContentDescriber/__init__.py:663
msgid "Cancel the active computer control session"
msgstr "Cancela la sesión de control del equipo activa"

#: addon/globalPlugins/AIContentDescriber/__init__.py:667
msgid "Snap a picture using the selected camera, then describe it using AI."
msgstr ""
"Tomar una foto con la cámara seleccionada y luego describirla usando IA."

#: addon/globalPlugins/AIContentDescriber/__init__.py:671
msgid ""
"Describe the position of the face in the frame using the selected camera, if"
" applicable."
msgstr ""
"Describir la posición de la cara en el encuadre usando la cámara "
"seleccionada, si corresponde."

#. Translators: spoken when computer use maximizes the target window at the
#. start of a session.
#: addon/globalPlugins/AIContentDescriber/computer_use.py:681
msgid "Window maximized"
msgstr "Ventana maximizada"

#. Translators: Title for the computer control session dialog
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:52
msgid "Computer Control Session"
msgstr "Sesión de control del equipo"

#. Translators: label of the read-only history field in the computer control
#. dialog
#. translators: The label of the read-only multi-line history field in the
#. conversation dialog.
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:64
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:60
msgid "&History:"
msgstr "&Historial:"

#. Translators: label of the message field in the computer control dialog
#. translators: The label of the message field in the conversation dialog.
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:69
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:65
msgid "Enter Your Message:"
msgstr "Ingrese su mensaje:"

#. Translators: the Send button in the computer control dialog
#. translators: The label of the Send button in the conversation dialog.
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:78
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:78
msgid "&Send"
msgstr "&Enviar"

#. Translators: the Save Output button in the computer control dialog
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:82
msgid "Save &Output"
msgstr "Guardar &salida"

#. Translators: the Close button in the computer control dialog
#. Translators: The label of the Close button in the conversation dialog.
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:86
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:82
msgid "Close"
msgstr "Cerrar"

#. translators: The text placed before a message from the AI in the
#. conversation dialog's history buffer. This is also spoken upon receipt of a
#. new message.
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:103
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:113
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:189
msgid "AI:"
msgstr "IA:"

#. translators: The text placed before a message sent by you in the
#. conversation dialog's history buffer. This is also spoken upon receipt of a
#. new message.
#. Description flow
#. Show user message immediately
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:105
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:101
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:153
msgid "You:"
msgstr "Usted:"

#. Translators: logged and spoken when a computer control session ends
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:141
msgid "Session ended"
msgstr "Sesión finalizada"

#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:171
#, python-brace-format
msgid ""
"The selected model would like to take control of your computer to perform "
"the requested task. You will be notified as actions occur, and you can press"
" {keystroke} any time to pause the session. Would you like to allow this?"
msgstr ""
"El modelo seleccionado quiere tomar el control de su equipo para realizar la"
" tarea solicitada. Se le notificará a medida que ocurran las acciones y "
"puede pulsar {keystroke} en cualquier momento para pausar la sesión. ¿Desea "
"permitirlo?"

#. Translators: spoken when the consent dialog appears, to alert the user to
#. switch to it
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:179
msgid "Consent required. Please check the dialog."
msgstr "Se requiere su consentimiento. Revise el diálogo."

#. Translators: shown in session history when the user declines consent
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:188
msgid "Session declined by user"
msgstr "Sesión rechazada por el usuario"

#. Translators: prompt in the save file dialog
#. translators: The prompt in the save file dialog.
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:194
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:229
msgid "Save conversation"
msgstr "Guardar conversación"

#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:195
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:230
msgid "Text files (*.txt)|*.txt"
msgstr "Archivos de texto (*.txt)|*.txt"

#. Translators: spoken when the session log is saved
#. translators: The message spoken when a conversation has been saved to disk
#. from the conversation dialog.
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:204
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:240
msgid "Conversation saved"
msgstr "Conversación guardada"

#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:206
#: addon/globalPlugins/AIContentDescriber/multimodal_input.py:242
msgid "Error saving file"
msgstr "Error al guardar el archivo"

#. Translators: title of the dialog asking whether to allow a risky AI action
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:218
msgid "Approve Action"
msgstr "Aprobar acción"

#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:223
#, python-brace-format
msgid ""
"The AI wants to perform a potentially risky action:\n"
"\n"
"{action}\n"
"\n"
"Allow it?"
msgstr ""
"La IA quiere realizar una acción potencialmente arriesgada:\n"
"\n"
"{action}\n"
"\n"
"¿Permitirla?"

#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:230
msgid "API safety warnings:"
msgstr "Advertencias de seguridad de la API:"

#. Translators: button to deny the AI action and stop the session
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:238
msgid "&Cancel"
msgstr "&Cancelar"

#. Translators: button to allow this one AI action
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:240
msgid "Approve &Once"
msgstr "Aprobar &una vez"

#. Translators: button to allow all remaining AI actions without further
#. prompting
#: addon/globalPlugins/AIContentDescriber/computer_use_dialogs.py:242
msgid "Approve &All"
msgstr "Aprobar &todas"

#. Translators: the message shown when required dependencies were not found
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:108
msgid ""
"Some of the dependencies required for this NVDA add-on to run are not "
"available on your computer. Would you like to download them now? NVDA will "
"need to be restarted when this process completes."
msgstr ""
"Algunas de las dependencias requeridas para ejecutar este complemento de "
"NVDA no están disponibles en su equipo. ¿Desea descargarlas ahora? NVDA "
"deberá reiniciarse cuando este proceso se complete."

#. Translators: the message shown when the wrong dependency versions were
#. found
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:118
msgid ""
"Some of the dependencies required for this NVDA add-on to run are outdated. "
"Would you like to try to install them now? NVDA will need to be restarted "
"when complete."
msgstr ""
"Algunas de las dependencias requeridas para ejecutar este complemento de "
"NVDA están desactualizadas. ¿Desea intentar instalarlas ahora? NVDA deberá "
"reiniciarse cuando se complete."

#. Translators: the message shown when the addon has successfully retrieved
#. the
#. new dependencies, asking the user whether they would like to delete the old
#. ones
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:128
msgid ""
"Would you like to delete the old dependencies from the configuration? This "
"question will be asked once. If you are running multiple versions of NVDA "
"interchangeably, select no."
msgstr ""
"¿Desea eliminar las dependencias antiguas de la configuración? Esta pregunta"
" se hará una vez. Si ejecuta varias versiones de NVDA de forma "
"intercambiable, seleccione no."

#. Translators: Message shown when NVDA is about to restart after the
#. dependencies have been downloaded.
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:138
msgid ""
"The dependencies have been downloaded successfully. NVDA will now restart "
"for the changes to take effect"
msgstr ""
"Las dependencias se han descargado correctamente. NVDA se reiniciará ahora "
"para que los cambios surtan efecto"

#. Translators: Message displayed when the dependency download from the
#. default
#. location failed and we are asking whether to try the mirror.
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:149
msgid ""
"There was an error downloading the dependencies required for this add-on to "
"function. Would you like to try again using the mirror provided by the "
"Chinese NVDA community?"
msgstr ""
"Hubo un error al descargar las dependencias requeridas para que este "
"complemento funcione. ¿Desea intentarlo de nuevo usando el espejo "
"proporcionado por la comunidad china de NVDA?"

#. Translators: Message displayed when there isn't yet libraries to support
#. the
#. running version of NVDA.
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:159
msgid ""
"Unfortunately, there doesn't yet seem to be dependencies available for the "
"running version of NVDA. Please submit an issue in our bug tracker or "
"contact the developers. In the meantime, you may wish to disable the add-on "
"to  surpress this  message on startup."
msgstr ""
"Desafortunadamente, todavía no parece haber dependencias disponibles para la"
" versión en ejecución de NVDA. Envíe un problema en nuestro sistema de "
"seguimiento de errores o contacte a los desarrolladores. Mientras tanto, es "
"posible que desee deshabilitar el complemento para suprimir este mensaje al "
"inicio."

#. Translators: Message shown when dependencies fail to download.
#: addon/globalPlugins/AIContentDescriber/dependency_checker.py:169
#, python-brace-format
msgid ""
"Unfortunately, there was a problem downloading the dependencies required to "
"run this add-on. Please consult the NVDA log for more details. {error}"
msgstr ""
"Desafortunadamente, hubo un problema al descargar las dependencias "
"requeridas para ejecutar este complemento. Consulte el registro de NVDA para"
" más detalles. {error}"

#. translators: error
#: addon/globalPlugins/AIContentDescriber/description_service.py:86
#: addon/globalPlugins/AIContentDescriber/description_service.py:150
msgid "error"
msgstr "error"

#. translators: message spoken when we can't connect (error with connection)
#: addon/globalPlugins/AIContentDescriber/description_service.py:92
#: addon/globalPlugins/AIContentDescriber/description_service.py:168
msgid "error making connection"
msgstr "error al realizar la conexión"

#. translators: message spoken when the connection is refused by our target
#: addon/globalPlugins/AIContentDescriber/description_service.py:99
#: addon/globalPlugins/AIContentDescriber/description_service.py:173
msgid "error, connection refused by target"
msgstr "error, conexión rechazada por el destino"

#. translators: the description for the GPT-5.4 model in the configuration
#. dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:770
msgid ""
"OpenAI's latest flagship model with advanced reasoning, vision, and a 400k "
"token context window."
msgstr ""
"El último modelo insignia de OpenAI con razonamiento avanzado, visión y una "
"ventana de contexto de 400k tokens."

#. translators: the description for the GPT-5.4 mini model in the
#. configuration
#. dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:782
msgid ""
"A fast, affordable variant of GPT-5.4 with vision support and a 400k token "
"context window."
msgstr ""
"Una variante rápida y asequible de GPT-5.4 con soporte de visión y una "
"ventana de contexto de 400k tokens."

#. translators: the description for the GPT-5.5 model in the configuration
#. dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:794
msgid ""
"OpenAI's frontier model for complex professional work, with a new class of "
"intelligence for coding, vision, and agentic tasks. Supports image input and"
" a 1M token context window."
msgstr ""
"El modelo de vanguardia de OpenAI para trabajos profesionales complejos, con"
" una nueva clase de inteligencia para programación, visión y tareas "
"agentivas. Admite entrada de imágenes y una ventana de contexto de 1M de "
"tokens."

#. translators: the description for the GPT-5.5 pro model in the configuration
#. dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:806
msgid ""
"A higher-compute variant of GPT-5.5 that thinks harder for smarter and more "
"precise responses on complex, high-stakes workloads. Supports image input "
"and a 1M token context window."
msgstr ""
"Una variante de mayor cómputo de GPT-5.5 que razona más en profundidad para "
"respuestas más inteligentes y precisas en cargas de trabajo complejas. "
"Admite entrada de imágenes y una ventana de contexto de 1M de tokens."

#. translators: the description for the GPT-6 Astra model in the configuration
#. dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:818
msgid ""
"OpenAI's most capable model for the most demanding work, such as complex "
"reasoning, coding, and computer control. Supports image input and a 1M token"
" context window. Costs more than the other GPT-6 models."
msgstr ""
"El modelo más capaz de OpenAI para el trabajo más exigente, como "
"razonamiento complejo, programación y control del equipo. Admite entrada de "
"imágenes y una ventana de contexto de 1M de tokens. Cuesta más que los otros"
" modelos GPT-6."

#. translators: the description for the GPT-6.1 Sol model in the configuration
#. dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:830
msgid ""
"Close to GPT-6 Astra on complex work at a lower cost. Supports image input "
"and a 1M token context window."
msgstr ""
"Cercano a GPT-6 Astra en trabajos complejos a un costo menor. Admite entrada"
" de imágenes y una ventana de contexto de 1M de tokens."

#. translators: the description for the GPT-6.1 Terra model in the
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:842
msgid ""
"A fast, affordable GPT-6.1 model at half the price of GPT-6.1 Sol. Supports "
"image input and a 1M token context window."
msgstr ""
"Un modelo GPT-6.1 rápido y asequible a la mitad del precio de GPT-6.1 Sol. "
"Admite entrada de imágenes y una ventana de contexto de 1M de tokens."

#. translators: the description for the GPT-6 Luna model in the configuration
#. dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:854
msgid ""
"OpenAI's lowest cost GPT-6 model, for high-volume work where price matters "
"most. Supports image input and a 1M token context window."
msgstr ""
"El modelo GPT-6 de menor costo de OpenAI, para trabajo de alto volumen donde"
" el precio es lo más importante. Admite entrada de imágenes y una ventana de"
" contexto de 1M de tokens."

#. translators: The description for the PollinationsAI model with OpenAI
#. support in the model selection dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:866
msgid ""
"Pollinations.AI is an open-source gen AI startup based in Berlin, providing "
"the most easy-to-use, free text and image generation API available. It "
"integrates with state-of-the-art models, no signups or API keys required."
msgstr ""
"Pollinations.AI es una startup de IA generativa de código abierto con sede "
"en Berlín que ofrece la API de generación de texto e imágenes gratuita más "
"fácil de usar. Se integra con modelos de última generación, sin necesidad de"
" registro ni claves de API."

#: addon/globalPlugins/AIContentDescriber/description_service.py:916
#, python-brace-format
msgid "Gemini encountered an error: {code}, {msg}"
msgstr "Gemini encontró un error: {code}, {msg}"

#: addon/globalPlugins/AIContentDescriber/description_service.py:930
msgid ""
"The model used all available tokens for reasoning and returned no visible "
"response. Try increasing the max tokens setting."
msgstr ""
"El modelo usó todos los tokens disponibles para razonar y no devolvió "
"ninguna respuesta visible. Intente aumentar el ajuste de tokens máximos."

#. translators: the description for Google's Gemini 2.5 Flash model, as shown
#. in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:964
msgid ""
"Gemini 2.5 Flash delivers fast performance for complex tasks. Ideal for "
"tasks like summarization, chat applications, data extraction, and "
"captioning."
msgstr ""
"Gemini 2.5 Flash ofrece rendimiento rápido para tareas complejas. Ideal para"
" tareas como resumen, aplicaciones de chat, extracción de datos y "
"subtitulado."

#. translators: the description for Google's Gemini 2.5 Flash-Lite model, as
#. shown in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:974
msgid ""
"Gemini 2.5 Flash-Lite is optimized for cost efficiency and low latency while"
" maintaining strong performance."
msgstr ""
"Gemini 2.5 Flash-Lite está optimizado para eficiencia de costos y baja "
"latencia manteniendo un sólido rendimiento."

#. translators: the description for Google's Gemini 2.5 Pro model, as shown in
#. the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:984
msgid ""
"Gemini 2.5 Pro models are capable of reasoning through their thoughts before"
" responding, resulting in enhanced performance and improved accuracy. Best "
"for coding and complex tasks."
msgstr ""
"Los modelos Gemini 2.5 Pro son capaces de razonar antes de responder, lo que"
" resulta en mejor rendimiento y mayor precisión. Ideal para programación y "
"tareas complejas."

#. translators: the description for Google's Gemini 3.1 Flash-Lite model, as
#. shown in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:994
msgid ""
"Gemini 3.1 Flash-Lite is optimized for cost efficiency and low latency in "
"high-frequency tasks."
msgstr ""
"Gemini 3.1 Flash-Lite está optimizado para eficiencia de costos y baja "
"latencia en tareas de alta frecuencia."

#. translators: the description for Google's Gemini 3.1 Pro Preview model, as
#. shown in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1004
msgid ""
"Gemini 3.1 Pro is Google's latest reasoning-first model for complex agentic "
"workflows, with enhanced performance and accuracy."
msgstr ""
"Gemini 3.1 Pro es el último modelo de razonamiento prioritario de Google "
"para flujos de trabajo agentivos complejos, con rendimiento y precisión "
"mejorados."

#. translators: the description for Google's Gemini 3.5 Flash model, as shown
#. in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1014
msgid ""
"Gemini 3.5 Flash is Google's latest and most capable Flash model, with "
"faster response times and reduced latency. Ideal for tasks requiring both "
"speed and quality."
msgstr ""
"Gemini 3.5 Flash es el modelo Flash más reciente y capaz de Google, con "
"tiempos de respuesta más rápidos y menor latencia. Ideal para tareas que "
"requieren velocidad y calidad."

#. translators: the description for Google's Gemini 3.5 Flash-Lite model, as
#. shown in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1024
msgid ""
"Gemini 3.5 Flash-Lite provides high throughput and cost efficiency for "
"lightweight multimodal processing."
msgstr ""
"Gemini 3.5 Flash-Lite ofrece alto rendimiento y eficiencia de costos para el"
" procesamiento multimodal ligero."

#. translators: the description for Google's Gemini 3.6 Flash model, as shown
#. in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1034
msgid ""
"Gemini 3.6 Flash offers balanced speed and accuracy for multimodal "
"understanding and captioning."
msgstr ""
"Gemini 3.6 Flash ofrece un equilibrio entre velocidad y precisión para la "
"comprensión multimodal y la generación de subtítulos."

#. translators: the description for Google's Gemini 3.7 Flash model, as shown
#. in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1044
msgid ""
"Gemini 3.7 Flash combines high-speed processing with advanced multimodal "
"capabilities and visual reasoning."
msgstr ""
"Gemini 3.7 Flash combina un procesamiento de alta velocidad con capacidades "
"multimodales avanzadas y razonamiento visual."

#. translators: the description for Google's Gemini 3.8 Flash model, as shown
#. in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1054
msgid ""
"Gemini 3.8 Flash delivers high-performance multimodal reasoning with fast "
"response times."
msgstr ""
"Gemini 3.8 Flash ofrece razonamiento multimodal de alto rendimiento con "
"tiempos de respuesta rápidos."

#. translators: the description for Google's Gemini 4 Hydrogen model, as shown
#. in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1064
msgid ""
"Gemini 4 Hydrogen is Google's fast, lower-cost Gemini 4 model for everyday "
"tasks, with a 1M token context window."
msgstr ""
"Gemini 4 Hydrogen es el modelo Gemini 4 rápido y de menor costo de Google "
"para tareas cotidianas, con una ventana de contexto de 1M de tokens."

#. translators: the description for Google's Gemini 4 Argon model, as shown in
#. the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1074
msgid ""
"Gemini 4 Argon is Google's frontier model for complex, multi-step work. It "
"requires the paid tier of the Gemini API."
msgstr ""
"Gemini 4 Argon es el modelo de vanguardia de Google para trabajos complejos "
"de varios pasos. Requiere el nivel de pago de la API de Gemini."

#. translators: the description for Google's Gemini 4 Carbon model, as shown
#. in
#. the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1084
msgid ""
"Gemini 4 Carbon is Google's most capable model, for hard, multi-step "
"reasoning. It thinks longer than Gemini 4 Argon, so responses are slower."
msgstr ""
"Gemini 4 Carbon es el modelo más capaz de Google, para razonamientos "
"difíciles de varios pasos. Piensa durante más tiempo que Gemini 4 Argon, por"
" lo que las respuestas son más lentas."

#: addon/globalPlugins/AIContentDescriber/description_service.py:1395
#, python-brace-format
msgid "Claude encountered an error. {err}"
msgstr "Claude encontró un error. {err}"

#. translators: the description for the Claude 4.5 Sonnet model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1436
msgid ""
"Anthropic's Sonnet model with extended thinking and a balance of speed and "
"intelligence."
msgstr ""
"El modelo Sonnet de Anthropic con pensamiento extendido y un equilibrio "
"entre velocidad e inteligencia."

#. translators: the description for the Claude 4.5 Opus model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1451
msgid ""
"Anthropic's Opus model with extended thinking, for complex reasoning and "
"analysis tasks."
msgstr ""
"El modelo Opus de Anthropic con pensamiento extendido, para tareas complejas"
" de razonamiento y análisis."

#. translators: the description for the Claude 4.6 Sonnet model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1467
msgid ""
"Anthropic's Sonnet model that balances speed and intelligence. Features a 1M"
" token context window and adaptive thinking."
msgstr ""
"El modelo Sonnet de Anthropic que equilibra velocidad e inteligencia. "
"Dispone de una ventana de contexto de 1M de tokens y pensamiento adaptativo."

#. translators: the description for the Claude 4.6 Opus model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1484
msgid ""
"Anthropic's Opus model for agents, coding, and complex reasoning. Features a"
" 1M token context window and adaptive thinking."
msgstr ""
"El modelo Opus de Anthropic para agentes, programación y razonamiento "
"complejo. Dispone de una ventana de contexto de 1M de tokens y pensamiento "
"adaptativo."

#. translators: the description for the Claude 4.7 Opus model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1501
msgid ""
"Anthropic's Opus model with high-resolution vision support up to 3.75MP, "
"adaptive thinking, and a 1M token context window."
msgstr ""
"El modelo Opus de Anthropic con soporte de visión de alta resolución de "
"hasta 3,75 MP, pensamiento adaptativo y una ventana de contexto de 1M de "
"tokens."

#. translators: the description for the Claude 4.8 Opus model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1519
msgid ""
"Anthropic's refined Opus model with the same high-resolution vision, "
"adaptive thinking, and 1M token context window as Claude 4.7 Opus."
msgstr ""
"El modelo Opus perfeccionado de Anthropic con la misma visión de alta "
"resolución, pensamiento adaptativo y ventana de contexto de 1M de tokens que"
" Claude 4.7 Opus."

#. translators: the description for the Claude 5 Sonnet model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1537
msgid ""
"Anthropic's fast and affordable Sonnet model with high-resolution vision, "
"adaptive thinking, and a 1M token context window."
msgstr ""
"El modelo Sonnet rápido y asequible de Anthropic con visión de alta "
"resolución, pensamiento adaptativo y una ventana de contexto de 1M de "
"tokens."

#. translators: the description for the Claude 5 Opus model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1555
msgid ""
"Anthropic's Opus model for complex reasoning and agentic tasks. Thinks by "
"default, with high-resolution vision and a 1M token context window."
msgstr ""
"El modelo Opus de Anthropic para razonamiento complejo y tareas agénticas. "
"Piensa de forma predeterminada, con visión de alta resolución y una ventana "
"de contexto de 1M de tokens."

#. translators: the description for the Claude 5 Fable model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1573
msgid ""
"Anthropic's frontier model above the Opus tier, for the most demanding "
"reasoning and vision tasks. Thinking is always on. Higher cost than Opus."
msgstr ""
"El modelo de vanguardia de Anthropic por encima del nivel Opus, para las "
"tareas de razonamiento y visión más exigentes. El pensamiento siempre está "
"activado. Cuesta más que Opus."

#. translators: the description for the Claude 5.1 Fable model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1591
msgid ""
"Anthropic's Fable model above the Opus tier, with stronger vision and "
"computer use than Claude 5 Fable. Thinking is always on. Higher cost than "
"Opus."
msgstr ""
"El modelo Fable de Anthropic por encima del nivel Opus, con mejor visión y "
"uso del equipo que Claude 5 Fable. El pensamiento siempre está activado. "
"Cuesta más que Opus."

#. translators: the description for the Claude 5.2 Fable model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1609
msgid ""
"Anthropic's most capable Fable model, for the most demanding reasoning and "
"vision tasks. Faster and lower cost than Claude 5.1 Fable. Thinking is "
"always on."
msgstr ""
"El modelo Fable más capaz de Anthropic, para las tareas de razonamiento y "
"visión más exigentes. Más rápido y de menor costo que Claude 5.1 Fable. El "
"pensamiento siempre está activado."

#. translators: the description for the Claude 5.5 Haiku model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1626
msgid ""
"Anthropic's fast, low-cost Haiku model for quick descriptions and high-"
"volume tasks. Thinks by default and has a 1M token context window."
msgstr ""
"El modelo Haiku rápido y de bajo costo de Anthropic para descripciones "
"rápidas y tareas de alto volumen. Piensa de forma predeterminada y tiene una"
" ventana de contexto de 1M de tokens."

#. translators: the description for the Claude 5.5 Sonnet model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1643
msgid ""
"Anthropic's Sonnet model for everyday vision, coding, and agentic tasks, "
"balancing speed and capability. Thinks by default, with high-resolution "
"vision and a 1M token context window."
msgstr ""
"El modelo Sonnet de Anthropic para tareas cotidianas de visión, programación"
" y agénticas, que equilibra velocidad y capacidad. Piensa de forma "
"predeterminada, con visión de alta resolución y una ventana de contexto de "
"1M de tokens."

#. translators: the description for the Claude 5.5 Opus model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1660
msgid ""
"Anthropic's Opus model for complex reasoning, coding, and agentic tasks, "
"priced below Claude 5 Opus. Thinking is always on, with high-resolution "
"vision and a 1M token context window."
msgstr ""
"El modelo Opus de Anthropic para razonamiento complejo, programación y "
"tareas agénticas, con un precio inferior al de Claude 5 Opus. El pensamiento"
" siempre está activado, con visión de alta resolución y una ventana de "
"contexto de 1M de tokens."

#. translators: the description for MistralAI's Mistral Large 4 model, as
#. shown
#. in the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1754
msgid ""
"Mistral's open-weight multimodal flagship model, with a 1M token context "
"window."
msgstr ""
"El modelo multimodal insignia de pesos abiertos de Mistral, con una ventana "
"de contexto de 1M de tokens."

#. translators: the description for the xAI Grok 4.3 model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1777
msgid ""
"xAI's recommended flagship reasoning model with a 1M token context window. "
"Features always-on chain-of-thought reasoning and support for image input."
msgstr ""
"El modelo insignia de razonamiento recomendado de xAI, con una ventana de "
"contexto de 1M de tokens. Dispone de razonamiento en cadena siempre activado"
" y admite entrada de imágenes."

#. translators: the description for the xAI Grok 4.5 model in the model
#. configuration dialog
#. translators: the description for the xAI Grok 4.6 model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1788
#: addon/globalPlugins/AIContentDescriber/description_service.py:1799
msgid ""
"An xAI reasoning model with image input and a 500k token context window. "
"Reasoning is always on."
msgstr ""
"Un modelo de razonamiento de xAI con entrada de imágenes y una ventana de "
"contexto de 500k tokens. El razonamiento siempre está activado."

#. translators: the description for the xAI Grok 4.7 model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1810
msgid ""
"xAI's most capable model, with image input and a 500k token context window. "
"Reasoning is always on."
msgstr ""
"El modelo más capaz de xAI, con entrada de imágenes y una ventana de "
"contexto de 500k tokens. El razonamiento siempre está activado."

#. translators: the description for the xAI Grok 4.20 (non-reasoning) model in
#. the model configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1821
msgid ""
"xAI's fast, low-cost model for instant responses without a reasoning step. "
"Supports image input and a 1M token context window."
msgstr ""
"El modelo rápido y de bajo costo de xAI para respuestas instantáneas sin "
"paso de razonamiento. Admite entrada de imágenes y una ventana de contexto "
"de 1M de tokens."

#. translators: the description for Moonshot AI's Kimi K3 model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1842
msgid ""
"Moonshot AI's flagship multimodal model, with a 1M token context window and "
"strong reasoning across text, image, and video."
msgstr ""
"El modelo multimodal insignia de Moonshot AI, con una ventana de contexto de"
" 1M de tokens y un sólido razonamiento sobre texto, imagen y video."

#. translators: the description for Moonshot AI's Kimi K2.6 model in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1852
msgid ""
"A capable Kimi multimodal model that understands both image and video input "
"alongside text."
msgstr ""
"Un modelo multimodal Kimi capaz que entiende entradas de imagen y video "
"junto con texto."

#. translators: the description for the Ollama model, as shown in the
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1864
msgid "The quickest way to get up and running with large language models."
msgstr ""
"La forma más rápida de comenzar a usar modelos de lenguaje de gran escala."

#. translators: the message spoken in the Ollama configuration dialog upon
#. pressing "list models", when the base URL cannot be contacted.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1882
#, python-brace-format
msgid "Could not contact the provided base URL. {error}"
msgstr "No se pudo contactar la URL base proporcionada. {error}"

#: addon/globalPlugins/AIContentDescriber/description_service.py:1913
#: addon/globalPlugins/AIContentDescriber/description_service.py:2043
#, python-brace-format
msgid "The response appears to be malformed. {response}"
msgstr "La respuesta parece estar mal formada. {response}"

#. translators: the description for the LiteLLM Proxy model, as shown in the
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:1947
msgid "Access multiple AI models through a unified LiteLLM proxy server."
msgstr ""
"Acceda a múltiples modelos de IA a través de un servidor proxy LiteLLM "
"unificado."

#. translators: the message spoken in the LiteLLM configuration dialog when no
#. base URL is provided
#: addon/globalPlugins/AIContentDescriber/description_service.py:1964
msgid "Please provide a base URL first."
msgstr "Por favor proporcione primero una URL base."

#. translators: the message spoken in the LiteLLM configuration dialog upon
#. pressing "list models", when the proxy cannot be contacted.
#: addon/globalPlugins/AIContentDescriber/description_service.py:1979
#, python-brace-format
msgid "Could not contact the LiteLLM proxy server. {error}"
msgstr "No se pudo contactar el servidor proxy LiteLLM. {error}"

#. translators: the message spoken when the LiteLLM proxy returns an
#. unexpected
#. response format
#: addon/globalPlugins/AIContentDescriber/description_service.py:1990
#, python-brace-format
msgid "Unexpected response format from LiteLLM proxy. {error}"
msgstr "Formato de respuesta inesperado del proxy LiteLLM. {error}"

#. translators: the description for the llama.cpp option in the model
#. configuration dialog
#: addon/globalPlugins/AIContentDescriber/description_service.py:2084
msgid ""
"llama.cpp is a state-of-the-art, open-source solution for running large language models locally and in the cloud.\n"
"This add-on integration assumes that you have obtained llama.cpp from Github and an image capable model from Huggingface or another repository, and that a server is currently running to handle requests. Though the process for getting this working is largely a task for the user that knows what they are doing, you can find basic steps in the add-on documentation."
msgstr ""
"llama.cpp es una solución de código abierto de última generación para ejecutar grandes modelos de lenguaje localmente y en la nube.\n"
"Esta integración del complemento asume que ha obtenido llama.cpp de Github y un modelo capaz de procesar imágenes de Huggingface u otro repositorio, y que actualmente hay un servidor en ejecución para manejar solicitudes. Aunque el proceso para lograr que esto funcione depende principalmente del usuario que sabe lo que hace, puede encontrar pasos básicos en la documentación del complemento."

#: addon/globalPlugins/AIContentDescriber/description_service.py:2131
#, python-brace-format
msgid ""
"Image recognition response appears to be malformed.\n"
"{response}"
msgstr ""
"La respuesta del reconocimiento de imagen parece estar mal formada.\n"
"{response}"

#. translators: the description for the vivo BlueLM Vision model, as shown in
#. the configuration dialog.
#: addon/globalPlugins/AIContentDescriber/description_service.py:2165
msgid ""
"A multimodal model from vivo, accessed via NVDA-CN account. This service is "
"provided by the NVDA Chinese community and requires your nvdacn.com "
"credentials."
msgstr ""
"Un modelo multimodal de vivo, accedido a través de una cuenta NVDA-CN. Este "
"servicio es proporcionado por la comunidad china de NVDA y requiere sus "
"credenciales de nvdacn.com."

#: addon/globalPlugins/AIContentDescriber/description_service.py:2240
#, python-brace-format
msgid "API Error: {error}"
msgstr "Error de API: {error}"

#: addon/globalPlugins/AIContentDescriber/description_service.py:2247
msgid "The model returned an empty response."
msgstr "El modelo devolvió una respuesta vacía."

#. This case is a safeguard; post() should raise an exception on failure.
#: addon/globalPlugins/AIContentDescriber/description_service.py:2292
msgid "Network request failed unexpectedly."
msgstr "La solicitud de red falló inesperadamente."

#: addon/globalPlugins/AIContentDescriber/description_service.py:2332
msgid "No active conversation. Please describe an image first."
msgstr "No hay conversación activa. Por favor describa una imagen primero."

#. translators: description of the Seer local vision provider
#: addon/globalPlugins/AIContentDescriber/description_service.py:2357
msgid ""
"Private, on-device image descriptions using PaliGemma2. No API key or cloud "
"connection required. Note: this is a captioning model, prompts and follow-up"
" questions are not supported. Install the Seer daemon to get started."
msgstr ""
"Descripciones de imágenes privadas en el dispositivo mediante PaliGemma2. No"
" se requiere clave de API ni conexión a la nube. Nota: es un modelo de "
"subtitulado, por lo que no admite indicaciones ni preguntas de seguimiento. "
"Instale el servicio Seer para empezar."

#: addon/globalPlugins/AIContentDescriber/description_service.py:2390
msgid ""
"Seer uses PaliGemma2 which describes images but does not support follow-up "
"questions."
msgstr ""
"Seer usa PaliGemma2, que describe imágenes pero no admite preguntas de "
"seguimiento."

#. translators: description of the Datalab Chandra 2 vision model
#: addon/globalPlugins/AIContentDescriber/description_service.py:2420
msgid ""
"Datalab Chandra 2 is a state-of-the-art vision and OCR model specialized in "
"complex document layouts, tables, forms, handwriting, charts, and math. "
"Supports Datalab's Cloud / On-Prem API as well as self-hosted OpenAI-"
"compatible vLLM endpoints."
msgstr ""
"Datalab Chandra 2 es un modelo de visión y OCR de última generación "
"especializado en diseños de documentos complejos, tablas, formularios, "
"escritura a mano, gráficos y matemáticas. Admite la API en la nube o local "
"de Datalab, así como endpoints vLLM autoalojados compatibles con OpenAI."

